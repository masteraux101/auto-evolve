# Required for GitHub tools + issue writeback
GITHUB_TOKEN=
TARGET_REPOSITORY=owner/repo
TARGET_BRANCH=main
ISSUE_NUMBER=
WRITE_BACK_TO_ISSUE=false

# Required for model calls
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Optional prompt fallback fields
USER_PROMPT=
ISSUE_TITLE=
ISSUE_BODY=

# Optional external requirements as JSON array
# Example: ["Need a CLI mode", "Add retry logic"]
NEW_REQUIREMENTS_JSON=

# Optional: one-shot planner tool action, consumed once each run.
# Example: {"action":"list_directory","input":{"path":"src"}}
PLANNER_TOOL_ACTION_JSON=
